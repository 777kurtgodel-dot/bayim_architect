# Скопируйте в .env и заполните. Файл .env не попадает в git.

# ── Обязательные ──────────────────────────────────────────────
# Адрес сайта без «/» в конце. Админка работает только по этому адресу.
SITE_URL=http://localhost:3000
# Длинная случайная строка, например результат команды: openssl rand -hex 32
PAYLOAD_SECRET=
# Для локальной разработки. В docker-compose задаётся автоматически.
DATABASE_URL=postgres://baiym:baiym@localhost:5432/baiym

# ── Сервер (docker-compose) ───────────────────────────────────
# Домен без https://, например baiym.kg
DOMAIN=
# Пароль базы данных, только латиница и цифры: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Почта (необязательно): уведомления о заявках и «Забыли пароль?» ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Telegram (необязательно): уведомления о заявках ───────────
# Токен бота от @BotFather. Chat ID указывается в админке: Настройки сайта → Уведомления.
TELEGRAM_BOT_TOKEN=

# ── Хранилище файлов S3 / Cloudflare R2 (необязательно) ───────
# Если не заполнено, файлы хранятся на сервере (папки media и private).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Первый администратор для `npm run seed` (необязательно) ───
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
