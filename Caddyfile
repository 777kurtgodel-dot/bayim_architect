# Caddy сам получает и продлевает HTTPS-сертификаты Let's Encrypt.
# Для домена нужны DNS-записи A (и www) на IP сервера.

{$DOMAIN} {
	encode zstd gzip
	# Форма заявки принимает до 5 файлов по 15 МБ
	request_body {
		max_size 100MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}

# www → основной домен (админка работает только на одном адресе — том, что указан в SITE_URL)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
